[Unit]
Description=Google HPC Multiqueue Script
Wants=rsyslog.service
Requires=network-online.target NetworkManager-wait-online.service
After=network-online.target rsyslog.service google-guest-agent.service NetworkManager-wait-online.service tuned.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 15
ExecStart=/usr/bin/google_hpc_multiqueue
#TimeoutStartSec is ignored for Type=oneshot service units.
KillMode=process
StandardOutput=journal

[Install]
WantedBy=multi-user.target
